[Unit]
Description=PLUTO Wi-Fi access point network address
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target pluto-hostapd.service pluto-dnsmasq.service pluto-captive-portal.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/pluto/pluto.env
ExecStart=/bin/sh -c 'rfkill unblock wifi || true; ip link set "$PLUTO_WIFI_IFACE" down || true; ip addr flush dev "$PLUTO_WIFI_IFACE" || true; ip addr add "$PLUTO_AP_IP/24" dev "$PLUTO_WIFI_IFACE"; ip link set "$PLUTO_WIFI_IFACE" up'
ExecStop=/bin/sh -c 'ip addr flush dev "$PLUTO_WIFI_IFACE" || true'

[Install]
WantedBy=multi-user.target
