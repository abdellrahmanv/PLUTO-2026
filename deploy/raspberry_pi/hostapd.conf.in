country_code={{PLUTO_COUNTRY}}
interface={{PLUTO_WIFI_IFACE}}
driver=nl80211
ssid={{PLUTO_SSID}}
ignore_broadcast_ssid=0
hw_mode=g
channel={{PLUTO_CHANNEL}}
ieee80211d=1
ieee80211n=1
require_ht=0
wmm_enabled=1
auth_algs=1
macaddr_acl=0
wpa=2
wpa_passphrase={{PLUTO_WIFI_PASSWORD}}
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
