[Unit]
Description=PLUTO operator website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PLUTO_USER__
Group=__PLUTO_USER__
EnvironmentFile=/etc/pluto/pluto.env
WorkingDirectory=__PLUTO_REPO__
ExecStart=/bin/sh -c 'exec "$PLUTO_PYTHON" -m pluto_runtime.web_shell --host "$PLUTO_WEB_HOST" --port "$PLUTO_WEB_PORT" $PLUTO_WEB_EXTRA_ARGS'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
