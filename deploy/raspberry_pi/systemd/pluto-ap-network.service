[Unit]
Description=PLUTO Wi-Fi access point network address
After=systemd-udevd.service
Before=network-pre.target pluto-hostapd.service pluto-dnsmasq.service pluto-captive-portal.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/pluto/pluto.env
TimeoutStartSec=35
ExecStart=/bin/bash __PLUTO_REPO__/deploy/raspberry_pi/pluto_ap_network.sh start
ExecStop=/bin/bash __PLUTO_REPO__/deploy/raspberry_pi/pluto_ap_network.sh stop

[Install]
WantedBy=multi-user.target
